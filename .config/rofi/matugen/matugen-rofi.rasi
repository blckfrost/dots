* {
    primary: #e3c36c;
    primary-fixed: #ffe08e;
    primary-fixed-dim: #e3c36c;
    on-primary: #3d2f00;
    on-primary-fixed: #241a00;
    on-primary-fixed-variant: #584400;
    primary-container: #584400;
    on-primary-container: #ffe08e;
    secondary: #d5c5a1;
    secondary-fixed: #f2e1bb;
    secondary-fixed-dim: #d5c5a1;
    on-secondary: #392f15;
    on-secondary-fixed: #231b04;
    on-secondary-fixed-variant: #50462a;
    secondary-container: #50462a;
    on-secondary-container: #f2e1bb;
    tertiary: #adcfad;
    tertiary-fixed: #c9ecc8;
    tertiary-fixed-dim: #adcfad;
    on-tertiary: #19361f;
    on-tertiary-fixed: #04210b;
    on-tertiary-fixed-variant: #304d34;
    tertiary-container: #304d34;
    on-tertiary-container: #c9ecc8;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #16130b;
    surface-alpha: rgba(22, 19, 11, 0.7);
    on-surface: #eae1d4;
    on-surface-variant: #cfc5b4;
    outline: #989080;
    outline-variant: #4c4639;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #eae1d4;
    inverse-on-surface: #343027;
    inverse-primary: #735b0c;
    surface-dim: #16130b;
    surface-bright: #3d392f;
    surface-container-lowest: #110e07;
    surface-container-low: #1f1b13;
    surface-container: #231f17;
    surface-container-high: #2d2a21;
    surface-container-highest: #39342b;
}
